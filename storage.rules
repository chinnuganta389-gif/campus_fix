rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated users can upload and view complaint evidence & resolution images
    match /complaints/{complaintId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Profile photos
    match /profiles/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
